{
  "name": "@led-control/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:shared": "pnpm --filter @led-control/shared build",
    "dev": "pnpm run build:shared && vite --host 0.0.0.0 --port ${WEB_PORT:-5173} --strictPort",
    "build": "tsc --noEmit && vite build",
    "brand:assets": "node scripts/render-brand-assets.mjs",
    "test": "vitest run",
    "test:cad-webgl": "playwright test --config=src/features/cad-scene/playwright.config.ts",
    "test:cad-monitoring-bundle": "node scripts/audit-cad-monitoring-bundle.mjs",
    "ui:check": "node scripts/ui-policy.mjs",
    "test:ui-policy": "node --test scripts/ui-policy.test.mjs",
    "test:date-bundle": "node --test scripts/date-bundle.mjs",
    "test:overlay-bundle": "node --test scripts/overlay-bundle.mjs",
    "test:bundle-audit": "pnpm run build:shared && node scripts/audit-schedule-bundle.mjs",
    "e2e:ui-cascade": "playwright test --config=playwright.ui-cascade.config.ts --project=chromium",
    "e2e:auth:real": "E2E_REAL_BACKEND_LAB=1 playwright test e2e/auth-real.spec.ts --project=chromium",
    "e2e:journey:real": "E2E_REAL_BACKEND_LAB=1 playwright test e2e/installation-customer-journey.spec.ts --project=chromium",
    "e2e:site-users:real": "E2E_REAL_BACKEND_LAB=1 playwright test e2e/site-user-management-real.spec.ts --project=chromium",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@led-control/shared": "workspace:*",
    "@tanstack/react-query": "^5.62.8",
    "class-variance-authority": "0.7.1",
    "earcut": "3.2.3",
    "konva": "^10.3.0",
    "lucide-react": "^0.468.0",
    "pixi.js": "8.21.0",
    "react": "^18.3.1",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.16",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "3.7.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "4.13.0",
    "jsdom": "^25.0.1",
    "mqtt": "^5.15.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
