{
  "name": "@led-control/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:shared": "pnpm --filter @led-control/shared build",
    "dev": "pnpm run build:shared && vite --host 0.0.0.0 --port ${WEB_PORT:-5173} --strictPort",
    "build": "tsc --noEmit && vite build",
    "brand:assets": "node scripts/render-brand-assets.mjs",
    "test": "vitest run",
    "test:bundle-audit": "pnpm run build:shared && node scripts/audit-schedule-bundle.mjs",
    "e2e:auth:real": "E2E_REAL_BACKEND_LAB=1 playwright test e2e/auth-real.spec.ts --project=chromium",
    "e2e:journey:real": "E2E_REAL_BACKEND_LAB=1 playwright test e2e/installation-customer-journey.spec.ts --project=chromium",
    "e2e:site-users:real": "E2E_REAL_BACKEND_LAB=1 playwright test e2e/site-user-management-real.spec.ts --project=chromium",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@led-control/shared": "workspace:*",
    "@tanstack/react-query": "^5.62.8",
    "konva": "^10.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.16",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "mqtt": "^5.15.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
