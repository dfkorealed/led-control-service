map $uri $cache_control {
  default "no-cache";
  ~^/assets/ "public, max-age=31536000, immutable";
  ~^/api/ "no-store";
}

server {
  listen 8080;
  server_name _;
  return 308 ${WEB_HTTPS_ORIGIN}$request_uri;
}

server {
  listen 8443 ssl;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  ssl_certificate /run/web-tls/web.crt;
  ssl_certificate_key /run/web-tls/web.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_tickets off;
  server_tokens off;
  # Do not log raw paths/query strings or client forwarding headers.
  access_log off;
  error_log /dev/stderr crit;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;
  add_header Cache-Control $cache_control;

  location /api/ {
    proxy_pass https://api:4000/;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_server_name on;
    proxy_ssl_name api;
    proxy_ssl_trusted_certificate /run/api-tls/api-ca.crt;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Overwrite both fields; public device TCP ingress must not forge a visitor.
    proxy_set_header X-Landing-Ingress-Secret "${LANDING_INGRESS_SECRET}";
    proxy_set_header X-Landing-Client-IP $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Request-Id $http_x_request_id;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
  }

  location = /index.html {
    try_files $uri =404;
  }

  location /assets/ {
    try_files $uri =404;
    # Cache-Control stays at server scope to preserve security header inheritance.
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
