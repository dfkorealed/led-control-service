{
  "name": "@led-control/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "pnpm --filter @led-control/automation-engine build && nest start --watch",
    "build": "nest build",
    "test": "jest",
    "test:command-migration": "pnpm --filter @led-control/shared build && jest src/commands/command-target-migration.integration.spec.ts --runInBand",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "reports:migration-preflight": "node scripts/check-report-migration-preflight.mjs",
    "auth:bootstrap-operator": "pnpm --filter @led-control/shared build && tsx prisma/bootstrap-operator.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@led-control/automation-engine": "workspace:*",
    "@led-control/shared": "workspace:*",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@pdf-lib/fontkit": "1.1.1",
    "@peculiar/x509": "~2.0.0",
    "@prisma/client": "^6.1.0",
    "dotenv": "^16.4.7",
    "earcut": "2.2.4",
    "exceljs": "4.4.0",
    "ioredis": "^5.4.2",
    "jszip": "3.10.2",
    "libtess": "1.2.2",
    "mqtt": "^5.15.2",
    "pdf-lib": "1.17.1",
    "polygon-clipping": "0.15.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.3",
    "@types/earcut": "2.1.4",
    "@types/jest": "^29.5.14",
    "@types/libtess": "1.2.0",
    "jest": "^29.7.0",
    "prisma": "^6.1.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
