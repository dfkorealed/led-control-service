{
  "name": "@led-control/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "pnpm --filter @led-control/shared build && nest start --watch",
    "build": "pnpm --filter @led-control/shared build && nest build",
    "test": "pnpm --filter @led-control/shared build && jest",
    "lint": "tsc --noEmit",
    "typecheck": "pnpm --filter @led-control/shared build && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "auth:bootstrap-owner": "pnpm --filter @led-control/shared build && tsx prisma/bootstrap-owner.ts",
    "gateway:enroll-inventory": "echo 'Deprecated: use POST /manufacturing/gateway-enrollments' && exit 1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@led-control/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@peculiar/x509": "~2.0.0",
    "@prisma/client": "^6.1.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "mqtt": "^5.10.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/testing": "^10.4.15",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "prisma": "^6.1.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
