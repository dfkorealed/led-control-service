generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FixtureStatus {
  online
  offline
  fault
}

enum CommandStatus {
  pending
  acknowledged
  failed
}

enum CommandDispatchStatus {
  pending
  published
  accepted
  completed
  failed
  timed_out
}

enum CommandFixtureResultStatus {
  pending
  succeeded
  failed
  timed_out
}

enum UserRole {
  operator
  admin
  viewer
}

enum OrganizationType {
  service_provider
  customer
}

enum UserStatus {
  active
  disabled
}

enum ProvisioningSessionStatus {
  active
  completed
  failed
  cancelled
}

enum ProvisioningScanStatus {
  pending
  scanning
  completed
  failed
}

enum FixtureGroupLifecycleStatus {
  active
  retiring
  retired
  invalid
}

enum DiscoveredNodeStatus {
  discovered
  identifying
  provisioning
  provisioned
  failed
  reconcile_required
}

enum FloorPlanSourceType {
  none
  image
  pdf
}

enum FloorAssetKind {
  original
  rendered
}

enum FloorAssetStatus {
  pending
  ready
}

enum CertificatePurpose {
  device
  mqtt
}

enum GatewayCertificateStatus {
  active
  pending
  replaced
  revoked
  expired
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  type        OrganizationType @default(customer)
  users       User[]
  sites       Site[]
  invitations Invitation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id                   String                @id @default(uuid())
  organizationId       String
  loginId              String?               @unique
  email                String                @unique
  name                 String
  passwordHash         String
  role                 UserRole
  status               UserStatus            @default(active)
  organization         Organization          @relation(fields: [organizationId], references: [id])
  administeredSite     Site?                 @relation("SiteAdmin")
  commands             Command[]
  sessions             Session[]
  provisioningSessions ProvisioningSession[]
  gatewayClaimAudits   GatewayClaimAudit[]
  siteMemberships      SiteMembership[]
  floorMapRevisions    FloorMapRevision[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model Site {
  id                   String                @id @default(uuid())
  organizationId       String
  adminUserId          String?               @unique
  name                 String
  address              String
  tariffKwhRate        Decimal               @db.Decimal(10, 2)
  timeZone             String                @default("Asia/Seoul")
  organization         Organization          @relation(fields: [organizationId], references: [id])
  admin                User?                 @relation("SiteAdmin", fields: [adminUserId], references: [id], onDelete: Restrict)
  floors               Floor[]
  gateways             Gateway[]
  groups               FixtureGroup[]
  commands             Command[]
  invitations          Invitation[]
  provisioningSessions ProvisioningSession[]
  gatewayClaimAudits   GatewayClaimAudit[]
  memberships          SiteMembership[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([organizationId])
}

model Floor {
  id                   String                @id @default(uuid())
  siteId               String
  name                 String
  level                Int
  nextFixtureSequence  Int                   @default(0)
  mapRevision          Int                   @default(0)
  editorLeaseFence     Int                   @default(0)
  editorLeaseTokenHash String?
  editorLeaseHolderId  String?
  editorLeaseHolderName String?
  editorLeaseAcquiredAt DateTime?
  editorLeaseExpiresAt DateTime?
  site                 Site                  @relation(fields: [siteId], references: [id])
  floorPlan            FloorPlan?
  fixtures             Fixture[]
  fixtureGroups        FixtureGroup[]
  mapObjects           FloorMapObject[]
  assets               FloorAsset[]
  provisioningSessions ProvisioningSession[]
  mapRevisions         FloorMapRevision[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([siteId])
}

model SiteMembership {
  id        String   @id @default(uuid())
  userId    String
  siteId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, siteId])
  @@index([siteId])
}

model FloorMapRevision {
  id                   String   @id @default(uuid())
  floorId              String
  revision             Int
  snapshot             Json
  snapshotSha256       String
  changeSummary        Json
  changedBy            String
  restoredFromRevision Int?
  floor                Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  user                 User     @relation(fields: [changedBy], references: [id], onDelete: Restrict)
  createdAt            DateTime @default(now())

  @@unique([floorId, revision])
  @@index([floorId, createdAt])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  siteId         String?
  actorId        String?
  action         String
  targetType     String
  targetId       String?
  outcome        String
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([siteId, createdAt])
  @@index([actorId, createdAt])
}

model FloorAsset {
  id         String           @id @default(uuid())
  floorId    String
  kind       FloorAssetKind
  status     FloorAssetStatus @default(pending)
  objectKey  String           @unique
  publicUrl  String
  mimeType   String
  sizeBytes  BigInt
  sha256     String
  readyAt    DateTime?
  floor      Floor            @relation(fields: [floorId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([floorId, status, createdAt])
}

model FloorPlan {
  id               String              @id @default(uuid())
  floorId          String              @unique
  imageUrl         String
  sourceType       FloorPlanSourceType @default(image)
  originalFileUrl  String?
  renderedImageUrl String?
  width            Int
  height           Int
  version          Int                 @default(1)
  floor            Floor               @relation(fields: [floorId], references: [id])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model Fixture {
  id                  String                 @id @default(uuid())
  floorId             String
  meshNodeId          String?                @unique
  name                String
  ratedWatt           Decimal                @db.Decimal(8, 2)
  x                   Float
  y                   Float
  size                Float                  @default(20)
  status              FixtureStatus          @default(offline)
  brightness          Int                    @default(0)
  rssi                Int?
  hopCount            Int?
  commandSuccessRate  Float?
  lastSeenAt          DateTime?
  lastStateEventId    String?                @unique
  lastStateSequence   BigInt?
  lastStateOccurredAt DateTime?
  statusReason        String?
  healthFaultCodes    Json?
  healthLastSeenAt    DateTime?
  energyTrackingStartedAt DateTime           @default(now())
  firstStateOccurredAt DateTime?
  powerOn             Boolean?
  floor               Floor                  @relation(fields: [floorId], references: [id])
  meshNode            MeshNode?              @relation(fields: [meshNodeId], references: [id])
  groupFixtures       GroupFixture[]
  energyUsages        EnergyUsage[]
  energyDailyAggregates FixtureEnergyDailyAggregate[]
  energyStateCursor   FixtureEnergyStateCursor?
  processedStateEvents ProcessedGatewayEvent[]
  commandResults      CommandFixtureResult[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([floorId, status])
  @@index([floorId, id])
}

model FloorMapObject {
  id          String   @id @default(uuid())
  floorId     String
  type        String
  x           Float
  y           Float
  width       Float?
  height      Float?
  rotation    Float    @default(0)
  points      Json?
  text        String?
  strokeColor String   @default("#0b63e5")
  fillColor   String?
  strokeWidth Float    @default(2)
  fontSize    Float?
  zIndex      Int      @default(0)
  locked      Boolean  @default(false)
  visible     Boolean  @default(true)
  floor       Floor    @relation(fields: [floorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([floorId, zIndex])
}

model FixtureGroup {
  id              String                      @id @default(uuid())
  siteId          String
  floorId         String?
  gatewayId       String?
  name            String
  lifecycleStatus FixtureGroupLifecycleStatus @default(active)
  site            Site                        @relation(fields: [siteId], references: [id])
  floor           Floor?                      @relation(fields: [floorId], references: [id], onDelete: Restrict)
  gateway         Gateway?                    @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  groupFixtures   GroupFixture[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@index([siteId, floorId, gatewayId, lifecycleStatus])
}

model GroupFixture {
  groupId   String
  fixtureId String
  group     FixtureGroup @relation(fields: [groupId], references: [id])
  fixture   Fixture      @relation(fields: [fixtureId], references: [id])

  @@id([groupId, fixtureId])
}

model Gateway {
  id                      String                  @id @default(uuid())
  siteId                  String
  name                    String
  serialNumber            String                  @unique
  firmwareVersion         String
  lastHeartbeatAt         DateTime?
  /// Active device certificate fingerprint pointer; canonical history is GatewayCertificate.fingerprint.
  certificateFingerprint  String?                 @unique
  assignmentVersion       Int                     @default(0)
  nextCommandSequence     BigInt                  @default(0)
  nextMeshUnicastAddress  Int                     @default(256)
  nextMeshGroupAddress    Int                     @default(49152)
  claimedAt               DateTime?
  lastHeartbeatEventId    String?                 @unique
  lastHeartbeatSequence   BigInt?
  lastHeartbeatOccurredAt DateTime?
  site                    Site                    @relation(fields: [siteId], references: [id])
  inventory               GatewayInventory?       @relation("GatewayInventoryClaim")
  meshNodes               MeshNode[]
  meshControlGroups       MeshControlGroup[]
  fixtureGroups           FixtureGroup[]
  provisioningSessions    ProvisioningSession[]
  commandDispatches       CommandDispatch[]
  processedEvents         ProcessedGatewayEvent[]
  certificates            GatewayCertificate[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([siteId])
}

model GatewayInventory {
  id                     String              @id @default(uuid())
  serialNumber           String              @unique
  claimCodeHash          String?
  /// Active device certificate fingerprint pointer; canonical history is GatewayCertificate.fingerprint.
  certificateFingerprint String?             @unique
  claimedGatewayId       String?             @unique
  claimedAt              DateTime?
  disabledAt             DateTime?
  claimedGateway         Gateway?            @relation("GatewayInventoryClaim", fields: [claimedGatewayId], references: [id])
  claimAudits            GatewayClaimAudit[]
  certificates           GatewayCertificate[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
}

model GatewayEnrollment {
  id              String   @id @default(uuid())
  serialNumber    String
  tokenHash       String   @unique
  expiresAt       DateTime
  usedAt          DateTime?
  stationIdentity String
  outcome         String?
  failureReason   String?
  createdAt       DateTime @default(now())

  @@index([serialNumber, createdAt])
}

model GatewayCertificate {
  id                String              @id @default(uuid())
  inventoryId       String
  gatewayId         String?
  purpose           CertificatePurpose
  certificateSerial String
  /// Canonical certificate fingerprint ledger; Gateway and GatewayInventory point to the active device certificate.
  fingerprint       String              @unique
  issuer            String
  notBefore         DateTime
  notAfter          DateTime
  /// PostgreSQL migration enforces one active MQTT certificate per inventory with a partial unique index.
  status            GatewayCertificateStatus
  revokedAt         DateTime?
  replacedById      String?             @unique
  inventory         GatewayInventory    @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  gateway           Gateway?            @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  replacedBy        GatewayCertificate? @relation("GatewayCertificateReplacement", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces          GatewayCertificate? @relation("GatewayCertificateReplacement")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([inventoryId, purpose, status])
  @@index([gatewayId, purpose, status])
  @@unique([issuer, certificateSerial])
}

model GatewayClaimAudit {
  id           String            @id @default(uuid())
  inventoryId  String?
  siteId       String?
  requestedBy  String?
  serialNumber String
  outcome      String
  reason       String?
  ipAddress    String?
  inventory    GatewayInventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  site         Site?             @relation(fields: [siteId], references: [id], onDelete: SetNull)
  user         User?             @relation(fields: [requestedBy], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())

  @@index([serialNumber, createdAt])
  @@index([siteId, createdAt])
}

model MeshNode {
  id              String   @id @default(uuid())
  gatewayId       String
  deviceUuid      String?  @unique
  serialNumber    String?
  meshAddress     String
  firmwareVersion String
  gateway         Gateway  @relation(fields: [gatewayId], references: [id])
  fixture         Fixture?
  controlGroupMemberships MeshControlGroupMember[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([id, gatewayId])
  @@unique([gatewayId, meshAddress])
  @@index([gatewayId])
}

enum MeshControlTargetType {
  floor
  fixture_group
}

enum MeshControlGroupStatus {
  configuring
  ready
  failed
  retiring
  retired
}

enum MeshControlGroupMemberSubscriptionStatus {
  pending
  applied
  failed
}

enum MeshControlGroupMemberOperation {
  add
  delete
}

model MeshControlGroup {
  id                   String                 @id @default(uuid())
  gatewayId            String
  targetType           MeshControlTargetType
  targetId             String
  groupAddress         String
  status               MeshControlGroupStatus @default(configuring)
  configurationVersion Int                    @default(1)
  operationPlanVersion Int                    @default(0)
  fullReconciliationRequired Boolean          @default(false)
  lastError            String?
  gateway              Gateway                @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  members              MeshControlGroupMember[]
  expectedOperations   MeshControlGroupExpectedOperation[]
  appliedMembers       MeshControlGroupAppliedMember[]
  commandDispatches    CommandDispatch[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([id, gatewayId])
  @@unique([gatewayId, targetType, targetId])
  @@unique([gatewayId, groupAddress])
  @@index([gatewayId, status])
}

model MeshControlGroupExpectedOperation {
  operationId          String                                   @id @default(uuid())
  groupId              String
  gatewayId            String
  configurationVersion Int
  action               MeshControlGroupMemberOperation
  meshNodeId           String
  meshAddress          String
  status               MeshControlGroupMemberSubscriptionStatus @default(pending)
  lastError            String?
  group                MeshControlGroup                         @relation(fields: [groupId, gatewayId], references: [id, gatewayId], onDelete: Cascade)
  createdAt            DateTime                                 @default(now())
  updatedAt            DateTime                                 @updatedAt

  @@unique([groupId, configurationVersion, action, meshNodeId, meshAddress])
  @@index([groupId, gatewayId, configurationVersion])
}

model MeshControlGroupAppliedMember {
  groupId     String
  gatewayId   String
  meshNodeId  String
  meshAddress String
  group       MeshControlGroup @relation(fields: [groupId, gatewayId], references: [id, gatewayId], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@id([groupId, meshNodeId, meshAddress])
  @@index([groupId, gatewayId])
}

model MeshControlGroupMember {
  groupId             String
  gatewayId           String
  meshNodeId          String
  subscriptionStatus  MeshControlGroupMemberSubscriptionStatus @default(pending)
  desired             Boolean                                 @default(true)
  appliedVersion      Int                                     @default(0)
  statusVersion       Int                                     @default(0)
  operationId         String?
  operation           MeshControlGroupMemberOperation?
  lastError           String?
  group               MeshControlGroup                        @relation(fields: [groupId, gatewayId], references: [id, gatewayId], onDelete: Cascade)
  meshNode            MeshNode                                @relation(fields: [meshNodeId, gatewayId], references: [id, gatewayId], onDelete: Cascade)
  createdAt           DateTime                                @default(now())
  updatedAt           DateTime                                @updatedAt

  @@id([groupId, meshNodeId])
  @@index([groupId, gatewayId])
  @@index([meshNodeId, gatewayId])
  @@index([meshNodeId, subscriptionStatus])
}

model Command {
  id           String            @id @default(uuid())
  siteId       String
  requestedBy  String
  clientRequestId String
  requestFingerprint String
  targetType   String
  targetId     String?
  targetFixtureIds Json               @default("[]")
  brightness   Int
  status       CommandStatus     @default(pending)
  errorMessage String?
  site         Site              @relation(fields: [siteId], references: [id])
  user         User              @relation(fields: [requestedBy], references: [id])
  dispatches   CommandDispatch[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([siteId, createdAt])
  @@unique([siteId, requestedBy, clientRequestId])
}

model CommandDispatch {
  id             String                 @id @default(uuid())
  commandId      String
  gatewayId      String
  idempotencyKey String                 @unique
  sequence       BigInt
  deliveryMode   String                 @default("unicast")
  destinationAddress String?
  meshControlGroupId String?
  meshControlGroupVersion Int?
  status         CommandDispatchStatus  @default(pending)
  publishedAt    DateTime?
  acceptedAt     DateTime?
  completedAt    DateTime?
  errorCode      String?
  errorMessage   String?
  command        Command                @relation(fields: [commandId], references: [id])
  gateway        Gateway                @relation(fields: [gatewayId], references: [id])
  meshControlGroup MeshControlGroup?     @relation(fields: [meshControlGroupId, gatewayId], references: [id, gatewayId], onDelete: Restrict)
  fixtureResults CommandFixtureResult[]
  outbox         MqttOutbox?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([gatewayId, sequence])
  @@index([commandId])
  @@index([gatewayId, status])
  @@index([meshControlGroupId, status])
}

model CommandFixtureResult {
  dispatchId   String
  fixtureId    String
  status       CommandFixtureResultStatus @default(pending)
  brightness   Int?
  faultCode    String?
  errorMessage String?
  rssi         Int?
  hopCount     Int?
  occurredAt   DateTime?
  dispatch     CommandDispatch            @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  fixture      Fixture                    @relation(fields: [fixtureId], references: [id])
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@id([dispatchId, fixtureId])
  @@index([fixtureId, status])
}

model MqttOutbox {
  id            String          @id @default(uuid())
  dispatchId    String          @unique
  topic         String
  payload       Json
  attempts      Int             @default(0)
  nextAttemptAt DateTime        @default(now())
  publishedAt   DateTime?
  lockedBy      String?
  lockedAt      DateTime?
  leaseExpiresAt DateTime?
  deadLetteredAt DateTime?
  lastError     String?
  dispatch      CommandDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([publishedAt, deadLetteredAt, nextAttemptAt, leaseExpiresAt])
}

model ProcessedGatewayEvent {
  eventId    String   @id
  gatewayId  String
  fixtureId  String?
  sequence   BigInt
  eventType  String
  occurredAt DateTime
  gateway    Gateway  @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  fixture    Fixture? @relation(fields: [fixtureId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@unique([gatewayId, sequence, eventType])
  @@index([gatewayId, occurredAt])
  @@index([fixtureId])
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  siteId         String?
  email          String?
  role           UserRole
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  site           Site?        @relation(fields: [siteId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  rememberMe Boolean   @default(false)
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model ProvisioningSession {
  id              String                    @id @default(uuid())
  siteId          String
  floorId         String
  gatewayId       String
  requestedBy     String
  status          ProvisioningSessionStatus @default(active)
  scanStatus      ProvisioningScanStatus    @default(pending)
  scanCorrelationId String?
  scanAttempt     Int                       @default(0)
  scanStartedAt   DateTime?
  scanCompletedAt DateTime?
  scanFailureCode String?
  scanFailureMessage String?
  site            Site                      @relation(fields: [siteId], references: [id])
  floor           Floor                     @relation(fields: [floorId], references: [id])
  gateway         Gateway                   @relation(fields: [gatewayId], references: [id])
  user            User                      @relation(fields: [requestedBy], references: [id])
  discoveredNodes DiscoveredMeshNode[]
  scanOutbox      ProvisioningScanOutbox[]
  startedAt       DateTime                  @default(now())
  completedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([gatewayId, scanStatus])
}

model ProvisioningScanOutbox {
  id             String               @id @default(uuid())
  sessionId      String
  scanAttempt    Int
  topic          String
  payload        Json
  attempts       Int                  @default(0)
  nextAttemptAt  DateTime             @default(now())
  publishedAt    DateTime?
  lockedBy       String?
  lockedAt       DateTime?
  leaseExpiresAt DateTime?
  deadLetteredAt DateTime?
  lastError      String?
  session        ProvisioningSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([sessionId, scanAttempt])
  @@index([publishedAt, deadLetteredAt, nextAttemptAt, leaseExpiresAt])
}

model DiscoveredMeshNode {
  id                 String               @id @default(uuid())
  sessionId          String
  deviceUuid         String
  serialNumber       String
  rssi               Int
  oobCapability      String
  firmwareVersion    String
  scanCorrelationId  String?
  scanAttempt        Int?
  status             DiscoveredNodeStatus @default(discovered)
  identifyState      String               @default("idle")
  meshAddress        String?
  pendingFixtureName String?
  pendingFixtureX    Float?
  pendingFixtureY    Float?
  pendingFixtureSize Float?
  pendingRatedWatt   Decimal?             @db.Decimal(8, 2)
  errorMessage       String?
  session            ProvisioningSession  @relation(fields: [sessionId], references: [id])
  discoveredAt       DateTime             @default(now())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([sessionId, deviceUuid])
}

model EnergyUsage {
  id        String   @id @default(uuid())
  fixtureId String
  source    String
  period    String
  kwh       Decimal  @db.Decimal(12, 4)
  cost      Decimal  @db.Decimal(12, 2)
  fixture   Fixture  @relation(fields: [fixtureId], references: [id])
  createdAt DateTime @default(now())
}

model FixtureEnergyDailyAggregate {
  id               String   @id @default(uuid())
  fixtureId        String
  localDate        DateTime @db.Date
  estimatedKwh     Decimal  @db.Decimal(20, 12)
  estimatedCost    Decimal  @db.Decimal(20, 8)
  knownSeconds     Int      @default(0)
  unknownSeconds   Int      @default(0)
  fixture          Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([fixtureId, localDate])
  @@index([localDate])
}

model FixtureEnergyStateCursor {
  fixtureId               String    @id
  aggregatedThrough       DateTime
  observedStateOccurredAt DateTime?
  brightness              Int
  powerOn                 Boolean?
  ratedWatt               Decimal   @db.Decimal(8, 2)
  durationRemainders      Json
  fixture                 Fixture   @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}
