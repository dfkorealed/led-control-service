generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FixtureStatus {
  online
  offline
  fault
}

enum CommandStatus {
  pending
  acknowledged
  failed
}

enum CommandDispatchStatus {
  pending
  published
  accepted
  completed
  failed
  timed_out
}

enum CommandFixtureResultStatus {
  pending
  succeeded
  failed
  timed_out
}

enum UserRole {
  owner
  admin
  operator
  viewer
}

enum UserStatus {
  active
  disabled
}

enum ProvisioningSessionStatus {
  active
  completed
  failed
  cancelled
}

enum DiscoveredNodeStatus {
  discovered
  identifying
  provisioning
  provisioned
  failed
}

enum FloorPlanSourceType {
  none
  image
  pdf
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  users       User[]
  sites       Site[]
  invitations Invitation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id                   String                @id @default(uuid())
  organizationId       String
  email                String                @unique
  name                 String
  passwordHash         String
  role                 UserRole
  status               UserStatus            @default(active)
  organization         Organization          @relation(fields: [organizationId], references: [id])
  commands             Command[]
  sessions             Session[]
  provisioningSessions ProvisioningSession[]
  gatewayClaimAudits   GatewayClaimAudit[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model Site {
  id                   String                @id @default(uuid())
  organizationId       String
  name                 String
  address              String
  tariffKwhRate        Decimal               @db.Decimal(10, 2)
  organization         Organization          @relation(fields: [organizationId], references: [id])
  floors               Floor[]
  gateways             Gateway[]
  groups               FixtureGroup[]
  commands             Command[]
  invitations          Invitation[]
  provisioningSessions ProvisioningSession[]
  gatewayClaimAudits   GatewayClaimAudit[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([organizationId])
}

model Floor {
  id                   String                @id @default(uuid())
  siteId               String
  name                 String
  level                Int
  site                 Site                  @relation(fields: [siteId], references: [id])
  floorPlan            FloorPlan?
  fixtures             Fixture[]
  mapObjects           FloorMapObject[]
  provisioningSessions ProvisioningSession[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([siteId])
}

model FloorPlan {
  id               String              @id @default(uuid())
  floorId          String              @unique
  imageUrl         String
  sourceType       FloorPlanSourceType @default(image)
  originalFileUrl  String?
  renderedImageUrl String?
  width            Int
  height           Int
  version          Int                 @default(1)
  floor            Floor               @relation(fields: [floorId], references: [id])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model Fixture {
  id                  String                 @id @default(uuid())
  floorId             String
  meshNodeId          String?                @unique
  name                String
  ratedWatt           Decimal                @db.Decimal(8, 2)
  x                   Float
  y                   Float
  size                Float                  @default(20)
  status              FixtureStatus          @default(offline)
  brightness          Int                    @default(0)
  rssi                Int?
  hopCount            Int?
  commandSuccessRate  Float?
  lastSeenAt          DateTime?
  lastStateEventId    String?                @unique
  lastStateSequence   BigInt?
  lastStateOccurredAt DateTime?
  statusReason        String?
  floor               Floor                  @relation(fields: [floorId], references: [id])
  meshNode            MeshNode?              @relation(fields: [meshNodeId], references: [id])
  groupFixtures       GroupFixture[]
  energyUsages        EnergyUsage[]
  commandResults      CommandFixtureResult[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([floorId, status])
}

model FloorMapObject {
  id          String   @id @default(uuid())
  floorId     String
  type        String
  x           Float
  y           Float
  width       Float?
  height      Float?
  rotation    Float    @default(0)
  points      Json?
  text        String?
  strokeColor String   @default("#0b63e5")
  fillColor   String?
  strokeWidth Float    @default(2)
  fontSize    Float?
  zIndex      Int      @default(0)
  locked      Boolean  @default(false)
  visible     Boolean  @default(true)
  floor       Floor    @relation(fields: [floorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([floorId, zIndex])
}

model FixtureGroup {
  id            String         @id @default(uuid())
  siteId        String
  name          String
  site          Site           @relation(fields: [siteId], references: [id])
  groupFixtures GroupFixture[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model GroupFixture {
  groupId   String
  fixtureId String
  group     FixtureGroup @relation(fields: [groupId], references: [id])
  fixture   Fixture      @relation(fields: [fixtureId], references: [id])

  @@id([groupId, fixtureId])
}

model Gateway {
  id                      String                  @id @default(uuid())
  siteId                  String
  name                    String
  serialNumber            String                  @unique
  firmwareVersion         String
  lastHeartbeatAt         DateTime?
  certificateFingerprint  String?                 @unique
  assignmentVersion       Int                     @default(0)
  claimedAt               DateTime?
  lastHeartbeatEventId    String?                 @unique
  lastHeartbeatSequence   BigInt?
  lastHeartbeatOccurredAt DateTime?
  site                    Site                    @relation(fields: [siteId], references: [id])
  inventory               GatewayInventory?       @relation("GatewayInventoryClaim")
  meshNodes               MeshNode[]
  provisioningSessions    ProvisioningSession[]
  commandDispatches       CommandDispatch[]
  processedEvents         ProcessedGatewayEvent[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([siteId])
}

model GatewayInventory {
  id                     String              @id @default(uuid())
  serialNumber           String              @unique
  claimCodeHash          String?
  certificateFingerprint String              @unique
  claimedGatewayId       String?             @unique
  claimedAt              DateTime?
  disabledAt             DateTime?
  claimedGateway         Gateway?            @relation("GatewayInventoryClaim", fields: [claimedGatewayId], references: [id])
  claimAudits            GatewayClaimAudit[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
}

model GatewayClaimAudit {
  id           String            @id @default(uuid())
  inventoryId  String?
  siteId       String?
  requestedBy  String?
  serialNumber String
  outcome      String
  reason       String?
  ipAddress    String?
  inventory    GatewayInventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  site         Site?             @relation(fields: [siteId], references: [id], onDelete: SetNull)
  user         User?             @relation(fields: [requestedBy], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())

  @@index([serialNumber, createdAt])
  @@index([siteId, createdAt])
}

model MeshNode {
  id              String   @id @default(uuid())
  gatewayId       String
  deviceUuid      String?  @unique
  serialNumber    String?
  meshAddress     String
  firmwareVersion String
  gateway         Gateway  @relation(fields: [gatewayId], references: [id])
  fixture         Fixture?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([gatewayId, meshAddress])
  @@index([gatewayId])
}

model Command {
  id           String            @id @default(uuid())
  siteId       String
  requestedBy  String
  targetType   String
  targetId     String
  brightness   Int
  status       CommandStatus     @default(pending)
  errorMessage String?
  site         Site              @relation(fields: [siteId], references: [id])
  user         User              @relation(fields: [requestedBy], references: [id])
  dispatches   CommandDispatch[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([siteId, createdAt])
}

model CommandDispatch {
  id             String                 @id @default(uuid())
  commandId      String
  gatewayId      String
  idempotencyKey String                 @unique
  sequence       BigInt
  status         CommandDispatchStatus  @default(pending)
  publishedAt    DateTime?
  acceptedAt     DateTime?
  completedAt    DateTime?
  errorCode      String?
  errorMessage   String?
  command        Command                @relation(fields: [commandId], references: [id])
  gateway        Gateway                @relation(fields: [gatewayId], references: [id])
  fixtureResults CommandFixtureResult[]
  outbox         MqttOutbox?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([gatewayId, sequence])
  @@index([commandId])
  @@index([gatewayId, status])
}

model CommandFixtureResult {
  dispatchId   String
  fixtureId    String
  status       CommandFixtureResultStatus @default(pending)
  brightness   Int?
  faultCode    String?
  errorMessage String?
  rssi         Int?
  hopCount     Int?
  occurredAt   DateTime?
  dispatch     CommandDispatch            @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  fixture      Fixture                    @relation(fields: [fixtureId], references: [id])
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@id([dispatchId, fixtureId])
  @@index([fixtureId, status])
}

model MqttOutbox {
  id            String          @id @default(uuid())
  dispatchId    String          @unique
  topic         String
  payload       Json
  attempts      Int             @default(0)
  nextAttemptAt DateTime        @default(now())
  publishedAt   DateTime?
  lastError     String?
  dispatch      CommandDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([publishedAt, nextAttemptAt])
}

model ProcessedGatewayEvent {
  eventId    String   @id
  gatewayId  String
  sequence   BigInt
  eventType  String
  occurredAt DateTime
  gateway    Gateway  @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([gatewayId, sequence, eventType])
  @@index([gatewayId, occurredAt])
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  siteId         String?
  email          String?
  role           UserRole
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  site           Site?        @relation(fields: [siteId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  rememberMe Boolean   @default(false)
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model ProvisioningSession {
  id              String                    @id @default(uuid())
  siteId          String
  floorId         String
  gatewayId       String
  requestedBy     String
  status          ProvisioningSessionStatus @default(active)
  site            Site                      @relation(fields: [siteId], references: [id])
  floor           Floor                     @relation(fields: [floorId], references: [id])
  gateway         Gateway                   @relation(fields: [gatewayId], references: [id])
  user            User                      @relation(fields: [requestedBy], references: [id])
  discoveredNodes DiscoveredMeshNode[]
  startedAt       DateTime                  @default(now())
  completedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
}

model DiscoveredMeshNode {
  id                 String               @id @default(uuid())
  sessionId          String
  deviceUuid         String
  serialNumber       String
  rssi               Int
  oobCapability      String
  firmwareVersion    String
  status             DiscoveredNodeStatus @default(discovered)
  identifyState      String               @default("idle")
  meshAddress        String?
  pendingFixtureName String?
  pendingFixtureX    Float?
  pendingFixtureY    Float?
  pendingRatedWatt   Decimal?             @db.Decimal(8, 2)
  errorMessage       String?
  session            ProvisioningSession  @relation(fields: [sessionId], references: [id])
  discoveredAt       DateTime             @default(now())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([sessionId, deviceUuid])
}

model EnergyUsage {
  id        String   @id @default(uuid())
  fixtureId String
  source    String
  period    String
  kwh       Decimal  @db.Decimal(12, 4)
  cost      Decimal  @db.Decimal(12, 2)
  fixture   Fixture  @relation(fields: [fixtureId], references: [id])
  createdAt DateTime @default(now())
}
