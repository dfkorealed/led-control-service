menu "LED Control Node"

config LED_CONTROL_BLUETOOTH_COMPANY_ID
    int "Bluetooth SIG assigned company identifier"
    range 1 65534
    help
        Bluetooth SIG가 자사에 할당한 Company Identifier를 10진수로 지정한다.
        Gateway의 GATEWAY_BLUETOOTH_COMPANY_ID와 반드시 같은 값이어야 한다.

config DFK_PRODUCT_FAMILY
    int "DFK product family code"
    default 1
    range 0 255

config DFK_MODEL_CODE
    int "DFK model code"
    default 1
    range 0 255

config DFK_HARDWARE_REVISION
    int "DFK hardware revision"
    default 1
    range 0 255

config LED_CONTROL_PWM_GPIO
    int "LED driver PWM GPIO"
    default 8

config LED_CONTROL_FACTORY_RESET_GPIO
    int "Factory reset active-low GPIO"
    default 9

config LED_CONTROL_FACTORY_RESET_HOLD_MS
    int "Factory reset hold duration (ms)"
    default 8000
    range 3000 30000

endmenu
