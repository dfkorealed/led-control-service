{
  "name": "@led-control/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/gateway.mjs",
    "dev": "pnpm --filter @led-control/shared build && pnpm --filter @led-control/automation-engine build && tsx src/index.ts",
    "bluez:probe": "tsx scripts/bluez-capability-probe.ts",
    "test": "vitest run --maxWorkers=1 --minWorkers=1",
    "test:contracts": "node --test docker/*.test.mjs",
    "test:mqtt-integration": "node --test docker/mqtt-persistence.integration.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@homebridge/dbus-native": "^0.7.7",
    "@led-control/automation-engine": "workspace:*",
    "@led-control/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "mqtt": "^5.15.2"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
