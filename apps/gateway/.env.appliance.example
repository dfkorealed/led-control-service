GATEWAY_IMAGE_REPOSITORY=led-control-gateway
GATEWAY_IMAGE_TAG=local
GATEWAY_DATA_DIR=/opt/led-control/data

MQTT_URL=mqtts://172.30.1.10:8883
GATEWAY_SERIAL=GW-REPLACE-WITH-DEVICE-SERIAL
GATEWAY_NAME=Raspberry Pi Gateway
GATEWAY_FIRMWARE_VERSION=gateway-appliance-local
GATEWAY_ADAPTER=bluez
GATEWAY_DEPLOYMENT_MODE=production
GATEWAY_BLUETOOTH_COMPANY_ID=REPLACE_WITH_BLUETOOTH_SIG_COMPANY_ID
# Lab HIL에서만 위 두 값을 lab-hil, 65534(0xFFFE)로 바꾸고 아래 확인값을 활성화한다.
# GATEWAY_LAB_HIL_ACK=NOT_FOR_PRODUCTION
# 상세 BlueZ/D-Bus 진단이 필요할 때만 1로 설정하고, 정상 운영에서는 0으로 유지한다.
# GATEWAY_BLUEZ_DEBUG=0
# Raspberry Pi 전용 controller는 검증된 raw-HCI 경로를 사용한다. auto는 장애 진단 전용이다.
GATEWAY_BLUEZ_IO=generic:hci0
GATEWAY_BLUEZ_ADAPTER_PATH=/org/bluez/hci0
GATEWAY_HEARTBEAT_MS=5000
GATEWAY_BLE_STATUS_TIMEOUT_MS=8000
GATEWAY_PROVISIONING_DEVICE_JOURNAL_PATH=/var/lib/led-control/provisioning-device-journal.json

GATEWAY_BOOTSTRAP_URL=https://172.30.1.10:4000/gateway-bootstrap
