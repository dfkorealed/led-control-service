MQTT_URL=mqtts://localhost:8883
MQTT_CA_PATH=/etc/led-control/mqtt-ca.crt
MQTT_CLIENT_CERT_PATH=/etc/led-control/gateway.crt
MQTT_CLIENT_KEY_PATH=/etc/led-control/gateway.key
GATEWAY_SERIAL=GW-LOCAL-001
GATEWAY_NAME=Local Gateway
GATEWAY_FIRMWARE_VERSION=gateway-dev-local
GATEWAY_HEARTBEAT_MS=5000
GATEWAY_BLE_STATUS_TIMEOUT_MS=8000
GATEWAY_ADAPTER=bluez
GATEWAY_ASSIGNMENT_PATH=/var/lib/led-control/assignment.json
GATEWAY_COMMAND_JOURNAL_PATH=/var/lib/led-control/command-journal.json
GATEWAY_EVENT_SEQUENCE_PATH=/var/lib/led-control/event-sequence.json
GATEWAY_AUTOMATION_CONFIG_PATH=/var/lib/led-control/automation-snapshot.json
GATEWAY_AUTOMATION_STATE_PATH=/var/lib/led-control/automation-state.json
GATEWAY_AUTOMATION_ACK_OUTBOX_PATH=/var/lib/led-control/automation-config-acks.json
GATEWAY_BOOTSTRAP_URL=https://api.example.com/gateway-bootstrap
GATEWAY_DEVICE_CERT_PATH=/etc/led-control/device.crt
GATEWAY_DEVICE_KEY_PATH=/etc/led-control/device.key
GATEWAY_BOOTSTRAP_CA_PATH=/etc/led-control/api-ca.crt
