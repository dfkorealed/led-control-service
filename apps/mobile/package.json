{
  "name": "@led-control/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "export": "expo export --platform all",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios",
    "prebuild": "expo prebuild --no-install",
    "build:android:local": "pnpm dlx eas-cli@24.10.0 build --platform android --profile preview --local",
    "build:ios:local": "pnpm dlx eas-cli@24.10.0 build --platform ios --profile simulator --local",
    "config": "expo config --type public"
  },
  "dependencies": {
    "@led-control/shared": "workspace:*",
    "expo": "57.0.26",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-sharing": "~57.0.22",
    "expo-network": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1",
    "react-dom": "19.2.3",
    "expo-system-ui": "~57.0.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^29.7.0",
    "react-test-renderer": "19.2.3",
    "ts-jest": "29.4.14",
    "typescript": "~6.0.3",
    "@babel/core": "^7.28.0",
    "babel-preset-expo": "~57.0.3",
    "expo-build-properties": "~57.0.22"
  }
}
