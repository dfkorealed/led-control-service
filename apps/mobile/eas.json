{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "local" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "env": { "APP_VARIANT": "development" } },
    "preview": { "distribution": "internal", "android": { "buildType": "apk" }, "env": { "APP_VARIANT": "production" } },
    "simulator": { "distribution": "internal", "ios": { "simulator": true }, "env": { "APP_VARIANT": "production" } },
    "production": { "env": { "APP_VARIANT": "production" } }
  }
}
