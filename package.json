{
  "name": "led-lighting-control-service",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @led-control/shared build && pnpm --parallel --filter @led-control/api --filter @led-control/web --filter @led-control/mock-gateway dev",
    "test": "pnpm --filter @led-control/shared build && pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @led-control/shared build && pnpm -r typecheck",
    "gateway:smoke": "pnpm --filter @led-control/shared build && pnpm --filter @led-control/gateway exec node scripts/local-smoke-test.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
