{
  "name": "@led-control/shared",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./automation-contracts": {
      "types": "./src/automation-action-result-contracts.ts",
      "browser": "./src/automation-action-result-contracts.ts",
      "require": "./dist/automation-action-result-contracts.js",
      "import": "./src/automation-action-result-contracts.ts",
      "default": "./dist/automation-action-result-contracts.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
