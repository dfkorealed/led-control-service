{
  "name": "@led-control/automation-engine",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build:dependencies": "pnpm --filter @led-control/shared build",
    "prebuild": "pnpm run build:dependencies",
    "build": "tsc",
    "pretest": "pnpm run build:dependencies",
    "test": "vitest run",
    "prelint": "pnpm run build:dependencies",
    "lint": "tsc --noEmit",
    "pretypecheck": "pnpm run build:dependencies",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@led-control/shared": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
