DATABASE_URL="postgresql://led:led@localhost:5432/led_control?schema=public"
REDIS_URL="redis://localhost:6379"
MQTT_URL="mqtt://localhost:1883"
MQTT_ALLOW_INSECURE_LOCAL="true"
MQTT_PUBLIC_URL="mqtts://localhost:8883"
API_PORT=4000
WEB_PORT=5173
WEB_PUBLIC_URL="http://localhost:5173"
# 세 경로를 모두 설정한 경우에만 API가 HTTPS로 장비 인증서를 요청합니다.
# API_TLS_CERT_PATH="/etc/led-control/pki/api.crt"
# API_TLS_KEY_PATH="/etc/led-control/pki/api.key"
# API_DEVICE_CLIENT_CA_PATH="/etc/led-control/pki/device-ca.crt"
VITE_USE_MOCK_API="false"
MOCK_SITE_ID="00000000-0000-4000-8000-000000000003"
MOCK_FIXTURE_IDS="00000000-0000-4000-8000-000000002001,00000000-0000-4000-8000-000000002002,00000000-0000-4000-8000-000000002003,00000000-0000-4000-8000-000000002004,00000000-0000-4000-8000-000000002005,00000000-0000-4000-8000-000000002006,00000000-0000-4000-8000-000000002007,00000000-0000-4000-8000-000000002008,00000000-0000-4000-8000-000000002009,00000000-0000-4000-8000-000000002010,00000000-0000-4000-8000-000000002011,00000000-0000-4000-8000-000000002012"
MOCK_GROUP_FIXTURE_IDS="00000000-0000-4000-8000-000000000006=00000000-0000-4000-8000-000000002001|00000000-0000-4000-8000-000000002002|00000000-0000-4000-8000-000000002003|00000000-0000-4000-8000-000000002004"
# S3-compatible floor asset storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_URL=http://localhost:9000/floor-assets
OBJECT_STORAGE_BUCKET=floor-assets
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=led-floor-assets
OBJECT_STORAGE_SECRET_KEY=replace-with-a-long-random-secret
