DATABASE_URL="postgresql://led:led@localhost:5432/led_control?schema=public"
# Floor editor concurrent lease requires Redis in every environment.
REDIS_URL="redis://localhost:6379"
MQTT_URL="mqtts://localhost:8883"
MQTT_PUBLIC_URL="mqtts://localhost:8883"
# API deployment instances must each use a distinct MQTT client ID suffix.
MQTT_API_INSTANCE_ID="development"
# LAN에서는 MQTT_URL/MQTT_PUBLIC_URL에 DNS 또는 IP를 사용합니다. 예: mqtts://mqtt.led.lan:8883, mqtts://192.168.1.11:8883
# PKI_LAB_CURRENT_DIR은 Vault가 발급한 current bundle 디렉터리입니다. 설정하면 pnpm dev는 개발 CA를 생성하거나 덮어쓰지 않습니다.
# PKI_LAB_CURRENT_DIR="/var/lib/led-control/pki/current"
# 명시 TLS 경로도 Vault bundle을 그대로 사용합니다. 개발 기본 PKI를 쓸 때는 모두 비워 둡니다.
# MQTT_CA_PATH="/var/lib/led-control/pki/current/mqtt-ca.crt"
# MQTT_CLIENT_CERT_PATH="/var/lib/led-control/pki/current/api-mqtt-client.crt"
# MQTT_CLIENT_KEY_PATH="/var/lib/led-control/pki/current/api-mqtt-client.key"
# Mosquitto server/client trust 경로입니다. PKI_LAB_CURRENT_DIR 기본 파일명과 다를 때만 설정합니다.
# MQTT_SERVER_CLIENT_CA_PATH="/var/lib/led-control/pki/current/mqtt-ca.crt"
# MQTT_SERVER_CERT_PATH="/var/lib/led-control/pki/current/mqtt-server.crt"
# MQTT_SERVER_KEY_PATH="/var/lib/led-control/pki/current/mqtt-server.key"
# MQTT_CLIENT_CRL_PATH="/var/lib/led-control/pki/current/mqtt-client.crl"
# Docker Mosquitto는 아래 host config와 인증서 디렉터리를 read-only로 mount합니다.
# MOSQUITTO_TLS_CONFIG_PATH="./infra/mosquitto.production-tls.conf"
# MQTT_TLS_CERT_DIR="/var/lib/led-control/pki/mosquitto-production"
API_PORT=4000
WEB_PORT=5173
WEB_PUBLIC_URL="http://localhost:5173"
# 테스트 데이터 도구는 기본 비활성화입니다. 개발/검증 현장에서만 아래 opt-in 플래그를 true로 설정하세요.
# VITE_TEST_DATA_TOOLS_ENABLED=true
# API HTTPS는 개발 환경에서 여섯 경로를 모두 설정하거나 모두 생략합니다. Production에서는 모두 필수입니다.
# API TLS 인증서는 LAN DNS/IP SAN을 포함한 Vault 발급 server certificate를 지정합니다.
# API_TLS_CERT_PATH="/etc/led-control/pki/api.crt"
# API_TLS_KEY_PATH="/etc/led-control/pki/api.key"
# API_DEVICE_CLIENT_CA_PATH="/etc/led-control/pki/device-ca.crt"
# API_MANUFACTURING_CLIENT_CA_PATH="/etc/led-control/pki/manufacturing-client-issuing-ca.crt"
# API_DEVICE_CRL_PATH="/etc/led-control/pki/device.crl"
# API_MANUFACTURING_CRL_PATH="/etc/led-control/pki/manufacturing.crl"
# 실제 Raspberry Pi gateway가 로컬 broker에 접속할 때 사용하는 DB Gateway.id
DEV_GATEWAY_ID=""
# S3-compatible floor asset storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_URL=http://localhost:9000/floor-assets
OBJECT_STORAGE_BUCKET=floor-assets
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=led-floor-assets
OBJECT_STORAGE_SECRET_KEY=replace-with-a-long-random-secret

# Gateway certificate authority. Development starts without a signer by default.
PKI_PROVIDER=unavailable
# Production requires PKI_PROVIDER=vault, HTTPS, and every path/role below.
VAULT_ADDR="https://vault.internal:8200"
VAULT_TOKEN_FILE="/run/secrets/vault-token"
VAULT_CA_CERT_PATH="/etc/led-control/pki/vault-ca.crt"
# Optional Vault Enterprise namespace.
VAULT_NAMESPACE=""
VAULT_PKI_DEVICE_MOUNT="gateway-device-pki"
VAULT_PKI_DEVICE_ROLE="gateway-device"
VAULT_PKI_MQTT_MOUNT="gateway-mqtt-pki"
VAULT_PKI_MQTT_ROLE="gateway-mqtt"
VAULT_REQUEST_TIMEOUT_MS=5000
# Enrollment 성공 응답에 포함할 public server CA bundle입니다. Private key 파일을 지정하지 않습니다.
PKI_API_CA_BUNDLE_PATH="/etc/led-control/pki/api-server-ca-bundle.crt"
PKI_MQTT_CA_BUNDLE_PATH="/etc/led-control/pki/mqtt-server-ca-bundle.crt"
